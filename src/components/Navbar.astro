---
import Button from "./Button.astro";
import { nav, ctaLabel } from "../content";
---
<header class="nav">
  <div class="container nav__bar">
    <a class="nav__brand" href="#top" aria-label="Synapxix, inicio">
      <img class="nav__logo nav__logo--dark" src="/logo-azul.png" alt="" width="44" height="44" />
      <img class="nav__logo nav__logo--light" src="/logo-claro.png" alt="" width="44" height="44" />
      <span>Synapxix</span>
    </a>
    <nav class="nav__links" aria-label="Principal">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav__cta"><Button href="#contacto">{ctaLabel}</Button></div>
    <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
      <span></span><span></span>
    </button>
  </div>
  <div class="nav__mobile" id="menu-movil" hidden>
    {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    <Button href="#contacto">{ctaLabel}</Button>
  </div>
</header>
<style>
  /* Sin JS la barra es siempre sólida; con JS flota transparente sobre el hero y se solidifica al bajar. */
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgba(246, 247, 255, 0.9); backdrop-filter: blur(10px); color: var(--noche); transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease; }
  .nav__bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
  .nav__brand { display: flex; align-items: center; gap: 8px; font-family: var(--font-titulo); font-weight: 700; font-size: 1.375rem; }
  .nav__logo--light { display: none; }
  .nav__links { display: none; gap: 32px; font-weight: 600; }
  .nav__links a:hover { color: var(--violeta); }
  .nav__cta { display: none; }
  .nav__toggle { display: grid; gap: 6px; width: 44px; height: 44px; place-content: center; background: #fff; border: 0; border-radius: 12px; cursor: pointer; }
  .nav__toggle span { display: block; width: 20px; height: 2px; background: var(--noche); }
  .nav__mobile { display: grid; gap: 4px; padding: 8px 20px 24px; }
  .nav__mobile[hidden] { display: none; }
  .nav__mobile a:not(.btn) { padding: 12px 0; font-weight: 600; border-bottom: 1px solid var(--linea); }
  .nav__mobile :global(.btn) { margin-top: 16px; justify-self: start; }

  :global(.js) .nav:not(.is-solid) { background: transparent; backdrop-filter: none; color: #fff; }
  :global(.js) .nav:not(.is-solid) .nav__logo--dark { display: none; }
  :global(.js) .nav:not(.is-solid) .nav__logo--light { display: block; }
  :global(.js) .nav:not(.is-solid) .nav__links a:hover { color: var(--cielo); }
  .nav.is-solid { box-shadow: 0 1px 0 rgba(16, 46, 74, 0.08); }

  @media (min-width: 960px) {
    .nav__links, .nav__cta { display: flex; }
    .nav__toggle, .nav__mobile { display: none; }
  }
</style>
<script>
  const nav = document.querySelector<HTMLElement>(".nav");
  const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
  const menu = document.getElementById("menu-movil");

  const actualizar = () => {
    const abierto = toggle?.getAttribute("aria-expanded") === "true";
    nav?.classList.toggle("is-solid", window.scrollY > 24 || abierto);
  };
  const cerrar = () => {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Abrir menú");
    menu?.setAttribute("hidden", "");
    actualizar();
  };

  window.addEventListener("scroll", actualizar, { passive: true });
  actualizar();

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    if (open) return cerrar();
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Cerrar menú");
    menu?.removeAttribute("hidden");
    actualizar();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    cerrar();
    toggle.focus();
  });
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", cerrar));
</script>
