---
import Button from "./Button.astro";
import { teachers, teacherBenefits } from "../content";
const icons = {
  chart: "M4 20V10M10 20V4M16 20v-7M22 20H2",
  check: "M5 12.5l4.5 4.5L19 7.5",
  shield: "M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6l8-3z",
  game: "M7 9h10a4 4 0 0 1 4 4v1a3 3 0 0 1-5.2 2L14 14h-4l-1.8 2A3 3 0 0 1 3 14v-1a4 4 0 0 1 4-4zM8 11v3M6.5 12.5h3",
};
---
<section class="section teachers">
  <div class="container">
    <div class="teachers__top reveal">
      <div>
        <span class="eyebrow">{teachers.eyebrow}</span>
        <h2>{teachers.title}</h2>
      </div>
      <div class="teachers__side">
        <p>{teachers.text}</p>
        <Button href="#contacto">Sumá tu escuela</Button>
      </div>
    </div>
    <div class="teachers__grid">
      {teacherBenefits.map((b) => (
        <article class="benefit reveal">
          <span class="benefit__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[b.icon]} /></svg>
          </span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .teachers__top { display: grid; gap: 28px; align-items: end; }
  .teachers__side { display: grid; gap: 24px; justify-items: start; }
  .teachers__side p { max-width: 520px; font-size: 1.0625rem; color: rgba(16, 46, 74, 0.78); }
  .teachers__grid { display: grid; gap: 20px; margin-top: clamp(40px, 6vw, 72px); }
  .benefit { display: grid; gap: 14px; align-content: start; padding: 32px; border-radius: var(--radio-tarjeta); background: #fff; border: 1px solid var(--linea); }
  .benefit__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--violeta-suave); color: var(--violeta); }
  .benefit h3 { font-size: 1.5rem; margin-top: 8px; }
  .benefit p { color: rgba(16, 46, 74, 0.8); }
  @media (min-width: 720px) { .teachers__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 860px) { .teachers__top { grid-template-columns: 1fr 1fr; gap: 72px; } }
  @media (min-width: 1100px) { .teachers__grid { grid-template-columns: repeat(4, 1fr); } }
</style>
