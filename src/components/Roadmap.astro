---
import { roadmap, roadmapIntro } from "../content";
---
<section class="roadmap">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">{roadmapIntro.eyebrow}</span>
      <h2>{roadmapIntro.title}</h2>
    </div>
    <ol class="roadmap__list">
      {roadmap.map((r, i) => (
        <li class="stage reveal">
          <span class="stage__dot">{i + 1}</span>
          <h3>{r.when}</h3>
          <p>{r.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .roadmap { background: var(--lavanda-suave); border-radius: 36px; margin: 0 clamp(0px, 1.5vw, 20px); padding: clamp(64px, 9vw, 112px) 0; }
  .roadmap__list { display: grid; gap: 20px; margin: clamp(32px, 5vw, 56px) 0 0; padding: 0; list-style: none; }
  .stage { display: grid; gap: 12px; align-content: start; padding: 32px; border-radius: var(--radio-tarjeta); background: #fff; }
  .stage__dot { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--violeta); color: #fff; font-family: var(--font-titulo); font-weight: 700; }
  .stage h3 { font-size: 1.75rem; }
  .stage p { color: rgba(16, 46, 74, 0.82); }
  @media (min-width: 860px) { .roadmap__list { grid-template-columns: repeat(3, 1fr); } }
</style>
