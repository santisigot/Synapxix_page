---
// Tarjeta "foil" 2.5D con el logo: inclinación en perspectiva + brillo reflectante que sigue al puntero.
// Es CSS + variables controladas por pointer events (sin Three.js ni video). Se usa en el hero y en el contacto.
const destellos = ["hspark--1", "hspark--2", "hspark--3", "hspark--4", "hspark--5"];
---
<div class="hstage">
  <span class="hstage__ring hstage__ring--1" aria-hidden="true"></span>
  <span class="hstage__ring hstage__ring--2" aria-hidden="true"></span>
  <span class="hstage__orbit" aria-hidden="true"></span>

  {destellos.map((d) => (
    <span class={`hspark ${d}`} aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 2l2.6 6.4L21 9.3l-4.9 4.3L17.6 21 12 17.6 6.4 21l1.5-7.4L3 9.3l6.4-.9z" fill="currentColor"/></svg>
    </span>
  ))}

  <div class="hcard__persp">
    <div
      class="hcard"
      data-foil-card
      tabindex="0"
      role="img"
      aria-label="Tarjeta con el logo de Synapxix: una estrella sonriente dentro de un triángulo. Se inclina con el mouse, el dedo o las flechas del teclado."
    >
      <div class="hcard__face">
        <span class="hcard__bg"></span>
        <span class="hcard__circle hcard__circle--1"></span>
        <span class="hcard__circle hcard__circle--2"></span>
        <img class="hcard__logo" src="/logo-claro.png" alt="" width="436" height="434" decoding="async" />
        <span class="hcard__word">Synapxix</span>
        <span class="hcard__foil"></span>
        <span class="hcard__sheen"></span>
        <span class="hcard__rim"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .hstage {
    --sx: 0; --sy: 0; --mxf: 0.5; --hover: 0;
    --rx: 0deg; --ry: 0deg; --tz: 0px; --s: 1;
    position: relative; display: grid; place-items: center; min-height: 340px; padding: 24px 0;
  }

  /* Anillos y órbita de fondo (decorativos, giran despacio) */
  .hstage__ring { position: absolute; left: 50%; top: 50%; translate: -50% -50%; border-radius: 50%; border: 1.5px dashed rgba(255, 255, 255, 0.22); animation: girar 50s linear infinite; pointer-events: none; }
  .hstage__ring--1 { width: min(480px, 112%); aspect-ratio: 1; }
  .hstage__ring--2 { width: min(620px, 140%); aspect-ratio: 1; border-style: solid; border-color: rgba(255, 255, 255, 0.1); animation-direction: reverse; animation-duration: 80s; }
  .hstage__orbit { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(480px, 112%); aspect-ratio: 1; animation: girar 24s linear infinite; pointer-events: none; }
  .hstage__orbit::before { content: ""; position: absolute; left: 50%; top: -5px; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: var(--cielo); box-shadow: 0 0 14px 3px rgba(85, 193, 255, 0.7); }

  /* Destellos: pequeñas estrellas que titilan y se desplazan apenas con el puntero */
  .hspark { position: absolute; z-index: 1; width: var(--z); height: var(--z); color: var(--c); pointer-events: none; opacity: 0.2;
    transform: translate(calc(var(--sx) * var(--px)), calc(var(--sy) * var(--py))); transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    animation: titilar 4.8s ease-in-out infinite; }
  .hspark svg { display: block; width: 100%; height: 100%; }
  .hspark--1 { --z: 16px; --c: var(--cielo); --px: 22px; --py: 14px; left: 8%; top: 12%; }
  .hspark--2 { --z: 11px; --c: #fff; --px: -26px; --py: 10px; right: 6%; top: 20%; animation-delay: -1.4s; }
  .hspark--3 { --z: 18px; --c: var(--lavanda); --px: -18px; --py: -16px; right: 12%; bottom: 12%; animation-delay: -2.6s; }
  .hspark--4 { --z: 10px; --c: #fff; --px: 24px; --py: -12px; left: 4%; bottom: 28%; animation-delay: -3.5s; }
  .hspark--5 { --z: 9px; --c: var(--cielo); --px: -10px; --py: 20px; left: 46%; top: 0%; animation-delay: -0.7s; }

  /* Perspectiva 1500px, una tarjeta 2:3 con cara recortada al 4% */
  .hcard__persp { position: relative; z-index: 2; perspective: 1500px; width: min(300px, 66vw); }
  .hcard {
    position: relative; aspect-ratio: 2 / 3; width: 100%; border-radius: 4%; cursor: grab; touch-action: pan-y;
    transform: translateZ(var(--tz)) rotateX(var(--rx)) rotateY(var(--ry)) scale(var(--s));
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), filter 0.25s ease;
    will-change: transform;
    filter: drop-shadow(0 calc(8px + 26px * var(--hover)) calc(16px + 34px * var(--hover)) rgba(0, 0, 0, calc(0.28 + 0.32 * var(--hover))));
  }
  .hcard:focus-visible { outline: 2px solid var(--cielo); outline-offset: 8px; }

  .hcard__face { position: absolute; inset: 0; overflow: hidden; border-radius: 4%; isolation: isolate; container-type: inline-size; }
  .hcard__face > * { position: absolute; }
  .hcard__bg { inset: 0; background: radial-gradient(120% 80% at 50% 28%, #24467a 0%, var(--noche) 48%, #091a2c 100%); }
  .hcard__circle { left: 50%; top: 40%; translate: -50% -50%; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.12); aspect-ratio: 1; }
  .hcard__circle--1 { width: 98%; }
  .hcard__circle--2 { width: 74%; border-color: rgba(85, 193, 255, 0.28); }
  .hcard__logo { left: 50%; top: 40%; translate: -50% -50%; width: 80%; height: auto; filter: drop-shadow(0 0 26px rgba(113, 90, 255, 0.6)); user-select: none; -webkit-user-drag: none; pointer-events: none; }
  .hcard__word { left: 0; right: 0; bottom: 6%; text-align: center; font-family: var(--font-titulo); font-weight: 700; font-size: 13.5cqw; letter-spacing: -0.02em; color: #fff; }

  /* Capas de brillo independientes de la imagen; la tipografía queda debajo, así el foil la cruza */
  .hcard__foil {
    inset: 0; mix-blend-mode: color-dodge; pointer-events: none;
    background: linear-gradient(115deg, var(--violeta) 0%, transparent 22%, var(--lavanda) 38%, transparent 50%, var(--cielo) 62%, transparent 80%, var(--azul) 100%);
    opacity: calc(0.7 * var(--hover)); transition: opacity 0.3s ease;
  }
  .hcard__sheen {
    inset: 0; mix-blend-mode: screen; pointer-events: none;
    background: linear-gradient(102deg, transparent 36%, rgba(255, 255, 255, 0.28) 46%, rgba(255, 255, 255, 0.62) 50%, rgba(255, 255, 255, 0.28) 54%, transparent 64%);
    background-size: 260% 100%; background-position-x: calc(var(--mxf) * 100%);
    opacity: calc(0.85 * var(--hover)); transition: opacity 0.25s ease;
  }
  .hcard__rim { inset: 0; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, calc(0.5 * var(--hover))), inset 0 0 calc(18px * var(--hover)) rgba(255, 255, 255, calc(0.18 * var(--hover))); }

  @keyframes girar { to { transform: rotate(360deg); } }
  @keyframes titilar {
    0%, 100% { opacity: 0.15; scale: 0.6; rotate: 0deg; }
    50% { opacity: 0.85; scale: 1; rotate: 25deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hcard, .hspark { transition: none; animation: none; }
    .hspark { opacity: 0.45; }
    .hstage__ring, .hstage__orbit { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-foil-card]").forEach((card) => {
    const stage = card.closest<HTMLElement>(".hstage");
    if (stage) montar(card, stage);
  });

  function montar(card: HTMLElement, stage: HTMLElement) {
    // Con "reducir movimiento": tarjeta en reposo, sin inclinación ni brillos, y sin foco de teclado.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      card.removeAttribute("tabindex");
      return;
    }

    // Zona donde el mouse inclina la tarjeta: la sección que la contiene (hero o contacto).
    const raiz = card.closest<HTMLElement>("section") ?? document.body;
    const ac = new AbortController();
    const opt = { signal: ac.signal };
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    let sx = 0, sy = 0, demoRaf = 0, interactuo = false, visible = false, introHecha = false;

    // Un único punto escribe las variables CSS; la transición del transform interpola (sin colas de animación).
    const aplicar = (x: number, y: number, mxf: number, hover: number) => {
      sx = x; sy = y;
      const s = stage.style;
      s.setProperty("--sx", x.toFixed(3));
      s.setProperty("--sy", y.toFixed(3));
      s.setProperty("--ry", `${(13 * x).toFixed(2)}deg`);
      s.setProperty("--rx", `${(-9 * y).toFixed(2)}deg`);
      s.setProperty("--tz", `${(46 * hover).toFixed(1)}px`);
      s.setProperty("--s", (1 + 0.05 * hover).toFixed(3));
      s.setProperty("--mxf", mxf.toFixed(3));
      s.setProperty("--hover", hover.toFixed(3));
    };
    const reposo = () => aplicar(0, 0, 0.5, 0);
    const detenerDemo = () => { cancelAnimationFrame(demoRaf); demoRaf = 0; };

    // Demostración finita de 5.2 s: se interrumpe al instante con cualquier interacción.
    const correrDemo = () => {
      detenerDemo();
      const inicio = performance.now();
      const frame = (ahora: number) => {
        const t = (ahora - inicio) / 5200;
        if (t >= 1) { demoRaf = 0; reposo(); return; }
        const f = Math.sin(Math.PI * t);
        const a = Math.sin(t * Math.PI * 3);
        aplicar(a * 0.85 * f, Math.cos(t * Math.PI * 2.2) * 0.55 * f, clamp(0.5 + 0.45 * a, 0, 1), f);
        demoRaf = requestAnimationFrame(frame);
      };
      demoRaf = requestAnimationFrame(frame);
    };

    // Mouse: el tilt se normaliza por el tamaño del viewport; el brillo, por el de la tarjeta.
    raiz.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      interactuo = true; detenerDemo();
      const r = card.getBoundingClientRect();
      const x = clamp((e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2), -1, 1);
      const y = clamp((e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2), -1, 1);
      aplicar(x, y, clamp((e.clientX - r.left) / r.width, 0, 1), 1);
    }, opt);
    raiz.addEventListener("pointerleave", () => { if (tid === null) reposo(); }, opt);
    window.addEventListener("blur", reposo, opt);

    // Táctil/lápiz: arrastre horizontal con pointer capture; el vertical queda para el scroll (touch-action: pan-y).
    let tid: number | null = null, ox = 0, oy = 0;
    card.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      tid = e.pointerId; ox = e.clientX; oy = e.clientY; interactuo = true; detenerDemo();
      try { card.setPointerCapture(e.pointerId); } catch { /* puntero ya liberado */ }
      const r = card.getBoundingClientRect();
      aplicar(0, 0, clamp((e.clientX - r.left) / r.width, 0, 1), 1);
    }, opt);
    card.addEventListener("pointermove", (e) => {
      if (e.pointerId !== tid) return;
      const r = card.getBoundingClientRect();
      aplicar(
        clamp((e.clientX - ox) / (r.width * 0.55), -1, 1),
        clamp((e.clientY - oy) / (r.height * 0.55), -1, 1),
        clamp((e.clientX - r.left) / r.width, 0, 1),
        1
      );
    }, opt);
    const soltar = (e: PointerEvent) => { if (e.pointerId !== tid) return; tid = null; reposo(); };
    card.addEventListener("pointerup", soltar, opt);
    card.addEventListener("pointercancel", soltar, opt);
    card.addEventListener("lostpointercapture", soltar, opt);

    // Teclado: flechas en pasos de .25, Inicio/Escape reposo, Enter/Espacio demostración.
    card.addEventListener("keydown", (e) => {
      const paso = 0.25;
      let x = sx, y = sy;
      switch (e.key) {
        case "ArrowLeft": x -= paso; break;
        case "ArrowRight": x += paso; break;
        case "ArrowUp": y -= paso; break;
        case "ArrowDown": y += paso; break;
        case "Home": case "Escape": e.preventDefault(); detenerDemo(); reposo(); return;
        case "Enter": case " ": e.preventDefault(); interactuo = true; correrDemo(); return;
        default: return;
      }
      e.preventDefault(); interactuo = true; detenerDemo();
      x = clamp(x, -1, 1); y = clamp(y, -1, 1);
      aplicar(x, y, clamp(0.5 + x * 0.5, 0, 1), 1);
    }, opt);
    card.addEventListener("blur", () => { detenerDemo(); reposo(); }, opt);

    // Pausa al ocultar la pestaña o salir de pantalla; una demostración inicial al verla por primera vez.
    document.addEventListener("visibilitychange", () => { if (document.hidden) { detenerDemo(); reposo(); } }, opt);
    const io = new IntersectionObserver((entradas) => {
      visible = entradas[0]?.isIntersecting ?? false;
      if (!visible) { detenerDemo(); reposo(); return; }
      if (!introHecha && !interactuo) { introHecha = true; setTimeout(() => { if (visible && !interactuo && !document.hidden) correrDemo(); }, 700); }
    }, { threshold: 0.6 });
    io.observe(card);

    window.addEventListener("pagehide", () => { ac.abort(); io.disconnect(); detenerDemo(); }, { once: true });
  }
</script>
