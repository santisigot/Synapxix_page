---
import { about, counters, triad } from "../content";
const tonos = ["cielo", "lavanda", "violeta"];
---
<section class="section about" id="proyecto">
  <div class="container">
    <div class="about__top">
      <div class="reveal">
        <span class="eyebrow">Sobre Synapxix</span>
        <h3>{about.title}</h3>
        <p class="about__text">{about.text}</p>
      </div>
      <dl class="about__counters reveal">
        {counters.map((c) => (
          <div class="counter">
            <dt>
              <span class="counter__num" data-target={c.target} data-final={c.display}>{c.display}</span>
              {c.target !== undefined && <span class="counter__plus">+</span>}
            </dt>
            <dd>{c.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="triad">
      {triad.map((t, i) => (
        <article class={`triad__card triad__card--${tonos[i]} reveal`}>
          <span class="triad__n">0{i + 1}</span>
          <h4>{t.title}</h4>
          <p>{t.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .about__top { display: grid; gap: 48px; }
  .about__text { margin-top: 20px; max-width: 520px; color: rgba(16, 46, 74, 0.78); font-size: 1.0625rem; }
  .about__counters { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 0; }
  .counter { padding: 24px 8px; border-top: 1px solid var(--linea); }
  .counter dt { font-family: var(--font-titulo); font-weight: 700; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1; color: var(--violeta); }
  .counter__plus { margin-left: 2px; }
  .counter dd { margin: 10px 0 0; font-size: 0.9375rem; color: rgba(16, 46, 74, 0.75); }
  .triad { display: grid; gap: 20px; margin-top: clamp(48px, 7vw, 88px); }
  .triad__card { display: grid; gap: 14px; align-content: start; min-height: 240px; padding: 36px; border-radius: var(--radio-tarjeta); }
  .triad__card--cielo { background: var(--cielo-suave); }
  .triad__card--lavanda { background: var(--lavanda-suave); }
  .triad__card--violeta { background: var(--violeta-suave); }
  .triad__n { font-family: var(--font-titulo); font-weight: 700; color: var(--violeta); }
  .triad__card h4 { font-size: 1.75rem; }
  .triad__card p { color: rgba(16, 46, 74, 0.8); }
  @media (min-width: 860px) {
    .about__top { grid-template-columns: 1fr 1fr; align-items: center; gap: 72px; }
    .triad { grid-template-columns: repeat(3, 1fr); }
  }
</style>
