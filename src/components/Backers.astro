---
import { backers, backersIntro } from "../content";
import SplitText from "./SplitText.astro";
const tonos = ["cielo", "lavanda", "violeta"];
---
<section class="section backers" id="respaldo">
  <div class="container">
    <div class="backers__head">
      <span class="eyebrow reveal">{backersIntro.eyebrow}</span>
      <h2><SplitText text={backersIntro.title} /></h2>
    </div>
    <ul class="backers__grid">
      {backers.map((b, i) => (
        <li class={`backer backer--${tonos[i % tonos.length]} reveal`}>
          <h3>{b.name}</h3>
          <p>{b.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .backers__grid { display: grid; gap: 20px; margin: clamp(32px, 5vw, 56px) 0 0; padding: 0; list-style: none; }
  .backer { display: grid; gap: 12px; align-content: start; min-height: 190px; padding: 32px; border-radius: var(--radio-tarjeta); }
  .backer--cielo { background: var(--cielo-suave); }
  .backer--lavanda { background: var(--lavanda-suave); }
  .backer--violeta { background: var(--violeta-suave); }
  .backer h3 { font-size: 1.375rem; font-weight: 700; line-height: 1.25; }
  .backer p { color: rgba(16, 46, 74, 0.82); }
  @media (min-width: 720px) { .backers__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .backers__grid { grid-template-columns: repeat(4, 1fr); } }
</style>
