---
import { hero, floaters } from "../content";
---
<!--
  Hero: 1) al entrar solo se carga el logo; 2) aparecen flotando, desordenadas, cosas clave del proyecto;
  3) al hacer scroll se dispersan y se llega al hero final: logo, "Synapxix" y una frase.
  Sin JavaScript (o con "reducir movimiento") se ve directamente el hero final. Colores planos, sin degradados.
-->
<section class="hero" data-hero data-nav="noche">
  <div class="hero__stage">
    <!-- Cosas clave flotando. Son decorativas: la información completa está en las secciones de abajo. -->
    <ul class="hero__floaters" aria-hidden="true">
      {floaters.map((f, i) => (
        <li
          class={`floater floater--${f.kind}`}
          style={`--i:${i};--x:${f.x};--y:${f.y};--r:${f.r}deg;--z:${f.z};${f.mx !== undefined ? `--mx:${f.mx};--my:${f.my};` : ""}`}
          data-m={f.mx !== undefined ? "" : undefined}
        >
          <div class="fl-disp">
            <div class="fl-card">
              {f.kind === "uni" && <span class="fl-mono">{f.mono}</span>}
              {f.kind === "pilar" && <span class="fl-n">{f.n}</span>}
              {f.big && <span class="fl-big">{f.big}</span>}
              <span class="fl-txt">{f.text}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="hero__group">
      <!-- El logo se "carga": la copia tenue se va llenando de abajo hacia arriba -->
      <div class="hero__logo" aria-hidden="true">
        <img class="base" src="/logo-claro.png" alt="" width="436" height="434" decoding="async" />
        <img class="fill" src="/logo-claro.png" alt="" width="436" height="434" decoding="async" />
      </div>
      <div class="hero__words">
        <h1>{hero.name}</h1>
        <p>{hero.phrase}</p>
      </div>
    </div>
  </div>
</section>
<!-- Antes del primer pintado: activa el modo animado (sin parpadeo). Sin JS o con "reducir movimiento" no se toca nada
     y se ve el hero final. Si el script principal no arranca en 7 s, se vuelve al hero final. -->
<script is:inline>
  (function () {
    var h = document.querySelector("[data-hero]");
    if (!h || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    h.dataset.fx = "on";
    h.dataset.intro = location.hash ? "done" : "load";
    setTimeout(function () {
      if (!h.dataset.started) { delete h.dataset.fx; delete h.dataset.intro; }
    }, 7000);
  })();
</script>
<style>
  /* ---------- Hero final (sin JS / reducir movimiento): logo, Synapxix y una frase, a pantalla completa ---------- */
  .hero { --p: 0; position: relative; overflow: hidden; overflow: clip; display: grid; place-items: center; min-height: 100vh; min-height: 100svh; background: var(--noche); color: #fff; }
  .hero__stage { width: 100%; }
  .hero__floaters { display: none; }
  .hero__group { display: grid; justify-items: center; gap: 22px; padding: 120px 20px 72px; text-align: center; }
  .hero__logo { position: relative; width: 132px; }
  .hero__logo img { display: block; width: 100%; height: auto; }
  .hero__logo .base { opacity: 0.22; }
  .hero__logo .fill { position: absolute; inset: 0; }
  .hero__words h1 { font-size: clamp(3.25rem, 9vw, 7rem); line-height: 1; letter-spacing: -0.045em; font-weight: 800; }
  .hero__words p { margin: 18px auto 0; max-width: 30rem; font-size: clamp(1.125rem, 2vw, 1.5rem); line-height: 1.35; color: rgba(255, 255, 255, 0.86); }

  /* ---------- Modo animado: escenario fijo durante un tramo corto de scroll (--p = progreso 0..1, lo escribe el script) ---------- */
  .hero[data-fx] { display: block; height: calc(100svh + 90svh); min-height: 0; scroll-margin-top: -88px; }
  .hero[data-fx] .hero__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; overflow: clip; }
  .hero[data-fx] .hero__group { position: absolute; left: 50%; top: 50%; display: block; padding: 0; width: 132px; height: 132px; margin: -66px 0 0 -66px; transform: translateY(calc(var(--p) * -96px)); }
  .hero[data-fx] .hero__words { position: absolute; top: calc(100% + 20px); left: 50%; width: min(92vw, 40rem); opacity: clamp(0, calc((var(--p) - 0.5) * 3.2), 1); transform: translate(-50%, calc((1 - clamp(0, calc((var(--p) - 0.5) * 3.2), 1)) * 18px)); }
  .hero[data-fx] .hero__floaters { display: block; position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }

  /* ---- 1. Carga del logo: solo el logo, que se llena de abajo hacia arriba ---- */
  .hero[data-fx][data-intro="load"] .fill { clip-path: inset(100% 0 0 0); animation: cargar-logo 1.5s cubic-bezier(0.65, 0, 0.25, 1) forwards; }
  .hero[data-fx][data-intro="pop"] .hero__logo { animation: pop-logo 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes cargar-logo { to { clip-path: inset(0 0 0 0); } }
  @keyframes pop-logo { 0% { transform: scale(1); } 40% { transform: scale(1.12); } 100% { transform: scale(1); } }

  /* ---- 2. Cosas clave flotando, desordenadas ---- */
  .floater { --ex: var(--x); --ey: var(--y); position: absolute; left: calc(var(--ex) * 1%); top: calc(var(--ey) * 1%); }
  /* 3. Al hacer scroll se dispersan hacia afuera (cada una a su ritmo, según su "profundidad" z) y se desvanecen */
  .fl-disp { transform: translate(calc((var(--ex) - 50) * 1.4vw * var(--p) * var(--z)), calc((var(--ey) - 50) * 1.4vh * var(--p) * var(--z))) rotate(var(--r)) scale(calc(1 - var(--p) * 0.3)); opacity: max(0, calc(1 - var(--p) * 1.8)); }
  .fl-card { display: flex; align-items: center; gap: 10px; width: max-content; max-width: 250px; padding: 10px 16px 10px 10px; border-radius: 16px; font-family: var(--font-titulo); font-weight: 700; font-size: 0.95rem; line-height: 1.2; }
  .floater--uni .fl-card { background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.3); color: #fff; }
  .fl-mono { flex-shrink: 0; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--cielo); color: var(--noche); font-weight: 800; font-size: 0.68rem; letter-spacing: -0.02em; }
  .floater--pilar .fl-card { background: var(--violeta-suave); color: var(--noche); }
  .fl-n { font-weight: 800; font-size: 1.5rem; line-height: 1; color: var(--violeta); }
  .floater--dato .fl-card, .floater--dato2 .fl-card { padding: 12px 18px; border-radius: 999px; }
  .floater--dato .fl-card { background: var(--violeta); color: #fff; }
  .floater--dato2 .fl-card { background: var(--cielo); color: var(--noche); }
  .fl-big { font-weight: 800; font-size: 1.75rem; line-height: 1; }

  /* Entrada: salen del logo hacia su sitio, escalonadas; antes de eso están ocultas */
  .hero[data-fx][data-intro="load"] .floater, .hero[data-fx][data-intro="pop"] .floater { opacity: 0; transform: translate(var(--fx, 0px), var(--fy, 0px)) scale(0.2); }
  .hero[data-fx][data-intro="float"] .floater, .hero[data-fx][data-intro="done"] .floater { transition: opacity 0.6s ease, transform 1.1s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i) * 70ms); }
  .hero[data-fx][data-intro="done"] .floater { transition-delay: 0s; }
  /* Flotación suave e irregular (propiedad `translate`, para no pisar los transform de arriba) */
  .hero[data-fx][data-intro="done"] .fl-card { animation: deriva calc(7s + var(--i) * 0.35s) ease-in-out infinite; animation-delay: calc(var(--i) * -1.1s); }
  .hero[data-vis="0"] .fl-card { animation-play-state: paused; }
  @keyframes deriva { 0%, 100% { translate: 0 0; } 25% { translate: 7px -11px; } 50% { translate: -6px -5px; } 75% { translate: -9px 6px; } }

  /* ---- Móvil: solo algunos elementos, en sus propias posiciones, más chicos ---- */
  @media (max-width: 800px) {
    .floater { --ex: var(--mx); --ey: var(--my); }
    .floater:not([data-m]) { display: none; }
    .fl-card { max-width: 170px; padding: 8px 12px 8px 8px; gap: 8px; font-size: 0.8rem; }
    .fl-mono { width: 32px; height: 32px; font-size: 0.6rem; }
    .fl-n { font-size: 1.2rem; }
    .fl-big { font-size: 1.4rem; }
    .floater--dato .fl-card, .floater--dato2 .fl-card { padding: 9px 14px; }
  }
</style>
<script>
  import { initHeroFx } from "../scripts/heroFx";
  initHeroFx();
</script>
