---
import Button from "./Button.astro";
import { hero } from "../content";
---
<section class="hero">
  <div class="hero__glow hero__glow--a"></div>
  <div class="hero__glow hero__glow--b"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1>{hero.title}</h1>
      <p>{hero.subtitle}</p>
      <div class="hero__actions">
        <Button href="#contacto">{hero.cta}</Button>
        <Button href="#proyecto">{hero.secondary}</Button>
      </div>
    </div>
    <div class="hero__art" aria-hidden="true">
      <div class="hero__card">
        <img src="/logo-claro.png" alt="" width="320" height="320" />
      </div>
      <span class="hero__dot hero__dot--1"></span>
      <span class="hero__dot hero__dot--2"></span>
      <span class="hero__dot hero__dot--3"></span>
    </div>
  </div>
</section>
<style>
  /* Ocupa toda la pantalla al entrar, también detrás de la barra (que flota transparente encima). */
  .hero { --btn-text: #fff; --btn-line: #fff; position: relative; overflow: hidden; display: grid; align-content: center; min-height: 100vh; min-height: 100svh; background: var(--noche); color: #fff; padding: 120px 0 72px; }
  .hero__glow { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.55; pointer-events: none; }
  .hero__glow--a { width: 520px; height: 520px; background: var(--violeta); top: -160px; right: -80px; }
  .hero__glow--b { width: 420px; height: 420px; background: var(--azul); bottom: -200px; left: -120px; opacity: 0.4; }
  .hero__inner { position: relative; display: grid; gap: 48px; align-items: center; }
  .hero__copy { display: grid; gap: 24px; }
  .hero__copy p { max-width: 540px; font-size: 1.125rem; color: rgba(255, 255, 255, 0.82); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  .hero__art { position: relative; display: grid; place-items: center; min-height: 280px; }
  .hero__card { display: grid; place-items: center; width: min(340px, 78vw); aspect-ratio: 1; border-radius: 32px; background: linear-gradient(145deg, var(--violeta), var(--azul)); transform: rotate(-4deg); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3); }
  .hero__card img { width: 78%; height: auto; transform: rotate(4deg); animation: flotar 6s ease-in-out infinite; }
  .hero__dot { position: absolute; border-radius: 50%; }
  .hero__dot--1 { width: 28px; height: 28px; background: var(--cielo); top: 8%; left: 10%; }
  .hero__dot--2 { width: 16px; height: 16px; background: var(--lavanda); bottom: 14%; right: 6%; }
  .hero__dot--3 { width: 44px; height: 44px; border: 3px solid var(--cielo); bottom: 6%; left: 18%; }
  @keyframes flotar { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
  @media (min-width: 960px) { .hero__inner { grid-template-columns: 1.15fr 0.85fr; } }
  @media (prefers-reduced-motion: reduce) { .hero__card img { animation: none; } }
</style>
