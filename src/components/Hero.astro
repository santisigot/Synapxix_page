---
import Button from "./Button.astro";
import { hero, unis } from "../content";
---
<section class="hero" data-hero>
  <div class="hero__glow hero__glow--a"></div>
  <div class="hero__glow hero__glow--b"></div>
  <div class="hero__dots" aria-hidden="true"></div>

  <div class="container hero__stage">
    <div class="hero__center">
      <!-- Anillo de carga que se convierte en el logo (arranque tipo app) -->
      <div class="hero__mark" aria-hidden="true">
        <span class="hero__ring"></span>
        <span class="hero__tile"><img src="/logo-claro.png" alt="" width="436" height="434" decoding="async" /></span>
      </div>
      <div class="hero__copy">
        <h1>{hero.title}</h1>
        <p>{hero.subtitle}</p>
        <div class="hero__actions">
          <Button href="#contacto">{hero.cta}</Button>
          <Button href="#proyecto">{hero.secondary}</Button>
        </div>
      </div>
    </div>

    <!-- Las instituciones salen del logo y quedan flotando a su alrededor -->
    <ul class="hero__unis" aria-label="Universidades e instituciones con las que trabajamos">
      {unis.map((u, i) => (
        <li class="uni" style={`--i:${i}`}>
          <span class="uni__mono" aria-hidden="true">{u.mono}</span>
          <span class="uni__name">{u.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
<!-- Con JS la secuencia de arranque empieza antes del primer pintado (sin parpadeo del estado final). Sin JS o con
     "reducir movimiento" se ve el estado final tal cual. Un temporizador de seguridad evita que quede a medias. -->
<script is:inline>
  (function () {
    var h = document.querySelector("[data-hero]");
    if (!h || location.hash || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    h.dataset.intro = "ring";
    setTimeout(function () { if (!h.dataset.started) h.dataset.intro = "done"; }, 7000);
  })();
</script>
<style>
  /* Ocupa toda la pantalla al entrar, también detrás de la barra (que flota transparente encima). */
  .hero { --btn-text: #fff; --btn-line: #fff; position: relative; overflow: hidden; overflow: clip; display: grid; align-content: center; min-height: 100vh; min-height: 100svh; background: var(--noche); color: #fff; padding: 120px 0 72px; }
  .hero__glow { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.55; pointer-events: none; }
  .hero__glow--a { width: 520px; height: 520px; background: var(--violeta); top: -160px; right: -80px; }
  .hero__glow--b { width: 420px; height: 420px; background: var(--azul); bottom: -200px; left: -120px; opacity: 0.4; }
  .hero__dots { position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(ellipse at 50% 50%, #000 0%, transparent 72%); }

  /* Sin position: así las instituciones (absolutas, ≥1200px) se colocan respecto de la pantalla entera y no del contenedor de 1200px */
  .hero__stage { display: grid; gap: 40px; }
  .hero__center { position: relative; z-index: 2; display: grid; justify-items: center; gap: 28px; text-align: center; }
  .hero__copy { display: grid; justify-items: center; gap: 20px; max-width: 34rem; }
  .hero__copy h1 { font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.1; }
  .hero__copy p { max-width: 30rem; font-size: 1.125rem; color: rgba(255, 255, 255, 0.82); }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; margin-top: 4px; }

  /* ---- Anillo + logo ---- */
  .hero__mark { position: relative; width: 132px; height: 132px; }
  .hero__tile { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 32px; background: linear-gradient(145deg, var(--violeta), var(--azul)); box-shadow: 0 20px 56px rgba(113, 90, 255, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.22); }
  .hero__tile img { width: 74%; height: auto; }
  .hero__ring { position: absolute; left: 50%; top: 50%; width: 88px; height: 88px; margin: -44px 0 0 -44px; border-radius: 50%; border: 17px solid var(--violeta); box-shadow: 0 0 0 14px rgba(113, 90, 255, 0.28); opacity: 0; pointer-events: none; }

  /* ---- Instituciones alrededor (escritorio ancho): flotan alrededor del bloque central ---- */
  .hero__unis { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; position: relative; z-index: 1; }
  .uni { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 10px 16px 10px 10px; border-radius: 18px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.22); backdrop-filter: blur(10px); }
  .uni__mono { flex-shrink: 0; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--cielo), var(--lavanda)); color: var(--noche); font-family: var(--font-titulo); font-weight: 800; font-size: 0.72rem; letter-spacing: -0.02em; }
  .uni__name { min-width: 0; overflow-wrap: anywhere; font-family: var(--font-titulo); font-weight: 700; font-size: 0.875rem; line-height: 1.25; }
  @media (max-width: 480px) {
    .uni { gap: 8px; padding: 8px 10px 8px 8px; }
    .uni__mono { width: 38px; height: 38px; font-size: 0.64rem; }
    .uni__name { font-size: 0.75rem; overflow-wrap: break-word; }
  }

  @media (min-width: 1200px) {
    .hero__unis { position: absolute; inset: 0; display: block; pointer-events: none; }
    .uni { position: absolute; width: 224px; }
    .uni:nth-child(1) { left: 4%; top: 17%; }
    .uni:nth-child(3) { left: 11%; top: 39%; }
    .uni:nth-child(5) { left: 3%; top: 60%; }
    .uni:nth-child(7) { left: 12%; top: 79%; }
    .uni:nth-child(2) { right: 4%; top: 15%; }
    .uni:nth-child(4) { right: 11%; top: 37%; }
    .uni:nth-child(6) { right: 3%; top: 58%; }
    .uni:nth-child(8) { right: 12%; top: 78%; }
  }

  /* ---- Estado final y flotación suave (sin intro o ya terminada) ---- */
  .hero__ring { transform: scale(0.6); }
  .hero:not([data-intro]) .uni, .hero[data-intro="done"] .uni { animation: flotar-uni 6.5s ease-in-out infinite; animation-delay: calc(var(--i) * -0.8s); }
  @keyframes flotar-uni { 0%, 100% { translate: 0 0; } 50% { translate: 0 -9px; } }
  @keyframes halo { 0%, 100% { box-shadow: 0 0 0 10px rgba(113, 90, 255, 0.34); } 50% { box-shadow: 0 0 0 26px rgba(113, 90, 255, 0.06); } }

  /* ---- Secuencia de arranque: ring -> logo -> text -> cards -> done (la dirige src/scripts/heroIntro.ts) ---- */
  @media (prefers-reduced-motion: no-preference) {
    /* 1. Solo el anillo pulsando: el resto está oculto */
    .hero[data-intro="ring"] .hero__tile { opacity: 0; transform: scale(0.55); }
    .hero[data-intro="ring"] .hero__ring { opacity: 1; transform: scale(1); animation: halo 1.3s ease-in-out infinite; }
    /* 2. El anillo se convierte en el logo */
    .hero[data-intro="logo"] .hero__ring, .hero[data-intro="text"] .hero__ring, .hero[data-intro="cards"] .hero__ring { opacity: 0; transform: scale(1.7); transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .hero[data-intro] .hero__tile { transition: opacity 0.4s ease, transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1); }
    /* 3. Aparece el texto */
    .hero[data-intro="ring"] .hero__copy, .hero[data-intro="logo"] .hero__copy { opacity: 0; transform: translateY(22px); }
    .hero[data-intro] .hero__copy { transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
    /* 4. Las instituciones salen del logo hacia su sitio, escalonadas */
    .hero[data-intro="ring"] .uni, .hero[data-intro="logo"] .uni, .hero[data-intro="text"] .uni { opacity: 0; transform: translate(var(--fx, 0px), var(--fy, 0px)) scale(0.3); }
    .hero[data-intro="cards"] .uni, .hero[data-intro="done"] .uni { transition: opacity 0.5s ease, transform 0.95s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i) * 90ms); }
    /* 5. Hecho: respuesta inmediata (la salida de la intro no arrastra retrasos) */
    .hero[data-intro="done"] .uni { transition-delay: 0s; }
  }
</style>
<script>
  import { initHeroIntro } from "../scripts/heroIntro";
  initHeroIntro();
</script>
