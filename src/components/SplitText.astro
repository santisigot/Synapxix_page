---
// Divide un texto en palabras al construir el sitio. Cada palabra queda dentro de una máscara
// y "se asienta" (sube y gira) al entrar en pantalla. El texto sigue siendo texto normal.
interface Props { text: string; delay?: number; }
const { text, delay = 0 } = Astro.props;
const palabras = text.split(/\s+/).filter(Boolean);
---
<span class="split" style={delay ? `--base:${delay}ms` : undefined}>{palabras.map((p, i) => (
  <><span class="w"><span class="w__i" style={`--i:${i}`}>{p}</span></span>{i < palabras.length - 1 ? " " : ""}</>
))}</span>
<style>
  /* Máscara por palabra; el relleno inferior evita recortar las letras con cola (g, p, y, j). */
  .w { display: inline-block; overflow: hidden; vertical-align: top; padding: 0.06em 0.04em 0.22em 0; margin: -0.06em -0.04em -0.22em 0; }
  .w__i { display: inline-block; transform-origin: left top; }

  @media (prefers-reduced-motion: no-preference) {
    /* Solo se oculta si hay JS (clase .js en <html>): sin JS el título se ve completo. */
    :global(.js) .w__i {
      transform: translateY(110%) rotate(5deg);
      transition: transform 600ms cubic-bezier(0.455, 0.03, 0.515, 0.955);
      transition-delay: calc(var(--base, 0ms) + var(--i) * 70ms);
    }
    :global(.js) .split.is-visible .w__i { transform: none; }
  }
</style>
