---
interface Props { href: string; }
const { href } = Astro.props;
---
<a class="btn" href={href}>
  <span class="btn__label"><slot /></span>
  <span class="btn__icon" aria-hidden="true">
    <span class="btn__arrow btn__arrow--out">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="btn__arrow btn__arrow--in">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </span>
</a>
<style>
  /* Sin relleno: el color lo define el fondo donde se use (--btn-text / --btn-line). */
  .btn {
    display: inline-flex; align-items: center; gap: 12px;
    color: var(--btn-text, var(--noche));
    font-family: var(--font-titulo); font-weight: 700; font-size: 1rem; letter-spacing: -0.01em;
    transition: background 0.25s ease, transform 0.2s ease;
  }
  .btn__icon { position: relative; overflow: hidden; display: block; width: 18px; height: 18px; flex-shrink: 0; color: var(--btn-line, var(--violeta)); }
  .btn__arrow { position: absolute; inset: 0; display: grid; place-items: center; transition: transform 0.35s cubic-bezier(0.5, 0, 0.2, 1); }
  .btn__arrow--in { transform: translateX(-120%); }
  .btn:hover .btn__arrow--out { transform: translateX(120%); }
  .btn:hover .btn__arrow--in { transform: translateX(0); }
  .btn:active { transform: scale(0.98); }

  /* Todos los botones: solo texto con flecha, subrayado al pasar el mouse */
  .btn { padding: 13px 4px; }
  .btn__label { position: relative; padding-bottom: 2px; }
  .btn__label::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: left center; transition: transform 0.3s ease; }
  .btn:hover .btn__label::after { transform: scaleX(1); }

  .btn:focus-visible { outline: 2px solid var(--cielo); outline-offset: 4px; border-radius: var(--radio-pildora); }
  @media (prefers-reduced-motion: reduce) {
    .btn, .btn__arrow, .btn__label::after { transition: none; }
    .btn:active { transform: none; }
  }
</style>
