---
import { dala, dalaSteps } from "../content";
import SplitText from "./SplitText.astro";
---
<section class="dala" id="como-funciona" data-nav="noche" data-dala>
  <div class="dala__bg" aria-hidden="true">
    <span class="dala__glow dala__glow--a"></span>
    <span class="dala__glow dala__glow--b"></span>
    <span class="dala__glow dala__glow--c"></span>
    <span class="dala__grid"></span>
  </div>
  <div class="container dala__inner">
    <div class="dala__top">
      <div class="dala__head">
        <span class="eyebrow reveal">{dala.eyebrow}</span>
        <h2><SplitText text={dala.title} /></h2>
      </div>
      <p class="dala__intro reveal">{dala.text}</p>
    </div>

    <!-- Filas desplegables nativas: sin JavaScript abren y cierran igual (details/summary). El script solo anima la altura. -->
    <div class="dala__list">
      {dalaSteps.map((s, i) => (
        <!-- Contenedor exterior: la entrada animada (settle, escalonada) va aquí para no interferir con las transiciones de la fila -->
        <div class="dala__item settle" style={`--k:${i}`}>
          <details class="dala__row" open={i === 0}>
            <summary class="dala__sum">
              <span class="dala__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="dala__label">{s.name}</span>
              <span class="dala__icon" aria-hidden="true"></span>
            </summary>
            <div class="dala__answer"><p>{s.text}</p></div>
          </details>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  /* Como el hero y el contacto: ocupa toda la pantalla al llegar (el margen negativo anula el scroll-padding de la barra). */
  /* overflow: clip (no hidden): los brillos se salen de la caja y, con hidden, el navegador puede desplazar la sección por dentro al enfocar algo. */
  .dala { position: relative; overflow: hidden; overflow: clip; color: #fff; display: grid; align-content: center; min-height: 100vh; min-height: 100svh; scroll-margin-top: -88px; padding: 108px 0 48px; background: linear-gradient(160deg, #0d2740 0%, var(--noche) 45%, #1a2f66 100%); }
  .dala__bg { position: absolute; inset: 0; pointer-events: none; }
  .dala__glow { position: absolute; border-radius: 50%; filter: blur(90px); }
  .dala__glow--a { width: 520px; height: 520px; background: var(--violeta); opacity: 0.45; top: -180px; right: -120px; }
  .dala__glow--b { width: 420px; height: 420px; background: var(--azul); opacity: 0.3; bottom: -160px; left: -140px; }
  .dala__glow--c { width: 300px; height: 300px; background: var(--cielo); opacity: 0.18; top: 40%; left: 42%; }
  .dala__grid { position: absolute; inset: 0; background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px); background-size: 28px 28px; mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent); }
  .dala .eyebrow { color: var(--cielo); }

  .dala__inner { position: relative; display: grid; gap: clamp(28px, 3.6vw, 44px); }
  /* Título arriba a la izquierda; la frase de apoyo, arriba a la derecha */
  .dala__top { display: grid; gap: 20px; }
  .dala__head { display: grid; gap: 14px; }
  .dala__intro { max-width: 440px; font-size: 1.125rem; color: rgba(255, 255, 255, 0.8); }
  @media (min-width: 960px) { .dala__top { grid-template-columns: 1fr 0.55fr; align-items: end; gap: 72px; } .dala__intro { justify-self: end; } }

  /* ---- Filas desplegables anchas ---- */
  .dala__list { display: grid; gap: 12px; }
  .dala__row { border-radius: var(--radio-tarjeta); background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.14); transition: background 0.3s ease, border-color 0.3s ease; }
  /* Abierta: mismo azul noche con un poco más de luz y borde celeste (el script marca data-intent; sin JS vale [open]) */
  .dala__row[data-intent="open"],
  .dala__row[open]:not([data-intent]) { background: linear-gradient(150deg, rgba(113, 90, 255, 0.38), rgba(255, 255, 255, 0.08)); border-color: rgba(85, 193, 255, 0.55); }

  .dala__sum { display: flex; align-items: center; gap: 18px; min-height: 72px; padding: 12px 22px; cursor: pointer; list-style: none; border-radius: var(--radio-tarjeta); }
  .dala__sum::-webkit-details-marker { display: none; }
  .dala__sum:focus-visible { outline: 2px solid var(--cielo); outline-offset: 3px; }
  .dala__num { font-family: var(--font-titulo); font-weight: 800; font-size: 1.875rem; line-height: 1; min-width: 3.2rem; background: linear-gradient(135deg, var(--cielo), var(--lavanda)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .dala__label { font-family: var(--font-titulo); font-weight: 700; font-size: clamp(1.125rem, 2.2vw, 1.5rem); }
  /* Solo el símbolo + / −, sin círculo ni botón */
  .dala__icon { margin-left: auto; flex-shrink: 0; width: 1.75rem; text-align: center; color: var(--cielo); font-family: var(--font-titulo); font-weight: 600; font-size: 2rem; line-height: 1; }
  .dala__icon::before { content: "+"; }
  .dala__row[data-intent="open"] .dala__icon::before,
  .dala__row[open]:not([data-intent]) .dala__icon::before { content: "−"; }

  /* La altura y la opacidad de la respuesta las anima el script; el contenido queda recortado */
  .dala__answer { overflow: hidden; }
  .dala__answer p { margin: 0; padding: 2px 24px 26px calc(22px + 3.2rem + 18px); font-size: 1.125rem; line-height: 1.55; color: rgba(255, 255, 255, 0.9); max-width: 60rem; }

  @media (max-width: 700px) {
    .dala__sum { min-height: 64px; padding: 10px 16px; gap: 14px; }
    .dala__num { font-size: 1.5rem; min-width: 2.6rem; }
    .dala__answer p { padding: 2px 18px 22px 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .dala__row { transition: none; } }
</style>
<script>
  import { initDalaRows } from "../scripts/dalaRows";
  initDalaRows();
</script>
