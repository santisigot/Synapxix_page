---
import { pillars, pillarsIntro } from "../content";
import SplitText from "./SplitText.astro";
const tonos = ["cielo", "lavanda", "violeta", "cielo"];
---
<!--
  Cuatro pilares: carrusel 3D curvo controlado por el scroll (WebGL, ver src/scripts/pillarsReel.ts).
  El listado de abajo es el respaldo accesible: se ve tal cual si no hay JavaScript o WebGL, y queda
  disponible para lectores de pantalla cuando el carrusel está activo.
-->
<section class="pillars" id="pilares" data-pillars style={`--pasos:${pillars.length - 1}`}>
  <div class="pillars__stage">
    <div class="pillars__paper" aria-hidden="true"></div>

    <div class="container pillars__head">
      <span class="eyebrow reveal">{pillarsIntro.eyebrow}</span>
      <h2 class="pillars__h2"><SplitText text={pillarsIntro.title} /></h2>
    </div>

    <canvas class="pillars__canvas" tabindex="0" role="img" aria-label={`${pillarsIntro.title}: ${pillars.map((p) => p.title).join(", ")}.`}></canvas>
    <p class="pillars__hint" aria-hidden="true">{pillarsIntro.hint}</p>

    <div class="container pillars__list">
      {pillars.map((p, i) => (
        <article
          class={`pillar pillar--${tonos[i]} reveal`}
          data-pillar data-n={p.n} data-title={p.title} data-text={p.text} data-tag={p.tag} data-tono={tonos[i]}
        >
          <span class="pillar__n">{p.n}</span>
          <div class="pillar__body">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
          <span class="pillar__tag">{p.tag}</span>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  /* ---- Respaldo (sin JS o sin WebGL): título y listado de tarjetas ---- */
  .pillars { padding: clamp(64px, 9vw, 120px) 0; }
  .pillars__paper, .pillars__canvas, .pillars__hint { display: none; }
  .pillars__list { display: grid; gap: 20px; margin-top: clamp(32px, 5vw, 56px); }
  .pillar { display: grid; gap: 20px; align-items: start; padding: 32px; border-radius: var(--radio-tarjeta); }
  .pillar--cielo { background: var(--cielo-suave); }
  .pillar--lavanda { background: var(--lavanda-suave); }
  .pillar--violeta { background: var(--violeta-suave); }
  .pillar__n { font-family: var(--font-titulo); font-weight: 800; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1; color: var(--violeta); }
  .pillar__body { display: grid; gap: 12px; }
  .pillar__body h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .pillar__body p { max-width: 640px; color: rgba(16, 46, 74, 0.82); font-size: 1.0625rem; }
  .pillar__tag { justify-self: start; padding: 8px 16px; border-radius: var(--radio-pildora); background: #fff; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  @media (min-width: 860px) {
    .pillar { grid-template-columns: 110px 1fr auto; align-items: center; padding: 40px; gap: 32px; }
  }

  /* ---- Carrusel activo (lo marca el script con data-reel="on"): escenario fijo durante un recorrido de scroll ---- */
  .pillars[data-reel="on"] { padding: 0; height: calc(100svh + var(--pasos) * 70svh); scroll-margin-top: -88px; }
  .pillars[data-reel="on"] .pillars__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; overflow: clip; display: grid; place-items: center; user-select: none; -webkit-user-select: none; }
  .pillars[data-reel="on"] .pillars__paper { display: block; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(70% 55% at 50% 42%, rgba(255, 255, 255, 0.95), transparent 70%),
                radial-gradient(rgba(16, 46, 74, 0.09) 1px, transparent 1.3px);
    background-size: auto, 6px 6px; }
  /* El título enorme va detrás de las tarjetas y queda parcialmente tapado por ellas */
  .pillars[data-reel="on"] .pillars__head { position: absolute; inset: 0; z-index: 1; display: grid; place-content: center; justify-items: center; gap: 12px; text-align: center; pointer-events: none; margin: 0; width: 100%; }
  .pillars[data-reel="on"] .pillars__h2 { font-size: clamp(4.5rem, 15.5vw, 13.5rem); line-height: 0.86; letter-spacing: -0.055em; font-weight: 800; color: var(--noche); }
  .pillars[data-reel="on"] .pillars__h2 :global(.split) { display: flex; flex-direction: column; align-items: center; }
  .pillars[data-reel="on"] .pillars__canvas { display: block; position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; touch-action: pan-y; cursor: grab; outline: none; }
  .pillars[data-reel="on"] .pillars__canvas:active { cursor: grabbing; }
  .pillars[data-reel="on"] .pillars__canvas:focus-visible { outline: 2px solid var(--cielo); outline-offset: -8px; }
  .pillars[data-reel="on"] .pillars__hint { display: block; position: absolute; z-index: 3; left: 50%; bottom: 30px; translate: -50% 0; margin: 0; font-size: 0.875rem; letter-spacing: 0.02em; color: rgba(16, 46, 74, 0.55); pointer-events: none; white-space: nowrap; }
  /* Móvil: la tarjeta central es ancha y baja; el título sube y crece para asomar por encima de ella (queda parcialmente tapado) */
  @media (max-width: 700px) {
    .pillars[data-reel="on"] .pillars__head { transform: translateY(-17svh); }
    .pillars[data-reel="on"] .pillars__h2 { font-size: 27vw; }
  }
  /* Listado accesible: fuera de la vista pero disponible para lectores de pantalla */
  .pillars[data-reel="on"] .pillars__list { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
</style>
<script>
  import { initPillarsReel } from "../scripts/pillarsReel";
  initPillarsReel();
</script>
