---
import { team, teamIntro } from "../content";
const tonos = ["var(--cielo)", "var(--lavanda)", "var(--violeta)"];
const textoSobre = ["var(--noche)", "var(--noche)", "#fff"];
---
<section class="section team" id="equipo">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">{teamIntro.eyebrow}</span>
      <h2>{teamIntro.title}</h2>
    </div>
    <div class="team__grid">
      {team.map((m, i) => (
        <article class="member reveal">
          <span class="member__avatar" style={`background:${tonos[i]};color:${textoSobre[i]}`} aria-hidden="true">{m.name.charAt(0)}</span>
          <span class="member__area">{m.area}</span>
          <h3>{m.name}</h3>
          <p class="member__role">{m.role}</p>
          <p>{m.text}</p>
        </article>
      ))}
    </div>
    <p class="team__pm reveal">{teamIntro.pm}</p>
  </div>
</section>
<style>
  .team__grid { display: grid; gap: 20px; margin-top: clamp(32px, 5vw, 56px); }
  .member { display: grid; gap: 8px; align-content: start; padding: 32px; border-radius: var(--radio-tarjeta); background: #fff; border: 1px solid var(--linea); }
  .member__avatar { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; font-family: var(--font-titulo); font-weight: 800; font-size: 1.75rem; margin-bottom: 12px; }
  .member__area { color: var(--violeta); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .member h3 { font-size: 1.625rem; }
  .member__role { font-weight: 700; }
  .member p:last-child { color: rgba(16, 46, 74, 0.8); }
  .team__pm { margin-top: 32px; font-size: 1.0625rem; color: rgba(16, 46, 74, 0.82); }
  @media (min-width: 860px) { .team__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
